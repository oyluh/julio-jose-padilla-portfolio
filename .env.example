# Required for shared global chat history on Vercel.
# Create an Upstash Redis database, then paste its REST URL and token here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Free-tier Gemini API key from Google AI Studio.
# Keep this server-side in Vercel; never put it in script.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Contact form delivery through Resend.
# Use a verified sender address/domain in CONTACT_FROM_EMAIL.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=padillajuliojose@gmail.com
